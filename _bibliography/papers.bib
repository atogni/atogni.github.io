@article{TOGNI2025110094,
title = {Accurate frequency estimation through iterative parabolic interpolations},
journal = {Signal Processing},
volume = {237},
pages = {110094},
year = {2025},
issn = {0165-1684},
doi = {10.1016/j.sigpro.2025.110094},
url = {https://www.sciencedirect.com/science/article/pii/S0165168425002087},
author = {Andrea Togni and Marco Zannoni and Paolo Tortora},
keywords = {Frequency estimation, DTFT interpolation, Iterative estimator, Maximum likelihood estimation, Successive parabolic interpolation},
abstract = {Extracting the frequency from a complex signal is a common task in many applications, and multiple methods exist for accurate frequency estimation under different noise conditions. Iterative algorithms based on the interpolation of the discrete Fourier transform (DFT) are known to achieve high accuracy, and methods that employ auxiliary coefficients around the peak of the DFT are recurrent in the literature. This paper presents a novel iterative algorithm for frequency estimation based on successive parabolic interpolations of three DFT coefficients. Unlike other similar methods, which typically require auxiliary fine estimators for bias reduction, the proposed method refines the frequency estimate by progressively decreasing the offset of the DFT coefficients employed at each iteration. This approach eliminates the need for external correction steps and enhances estimation accuracy as the interpolation narrows around the true frequency. The algorithm achieves performance very close to the Cramér-Rao lower bound while maintaining computational efficiency, and the fine estimation step implemented can be flexibly applied to signals with or without zero-padding, making its use suitable for a wide range of signal processing applications. Simulations confirm the high accuracy and robustness to noise of the proposed estimator, showing comparable or better performance than existing iterative techniques.},
preview={fes25.png},
}

@article{https://doi.org/10.1029/2024GL113231,
author = {Caruso, Andrea and Gomez Casajus, Luis and Smirnova, Maria and Buccino, Dustin and Galanti, Eli and Hubbard, William B. and Togni, Andrea and Gramigna, Edoardo and Parisi, Marzia and Park, Ryan S. and Zannoni, Marco and Steffes, Paul G. and Levin, Steven M. and Bolton, Scott J. and Tortora, Paolo and Kaspi, Yohai},
title = {Probing Jupiter's Atmosphere Through Juno Radio Occultations: Methodology and Initial Observations},
journal = {Geophysical Research Letters},
volume = {52},
number = {22},
pages = {e2024GL113231},
keywords = {jupiter, atmosphere, radio occultation, ray tracing, juno},
doi = {10.1029/2024GL113231},
url = {https://agupubs.onlinelibrary.wiley.com/doi/abs/10.1029/2024GL113231},
eprint = {https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1029/2024GL113231},
note = {e2024GL113231 2024GL113231},
abstract = {This paper presents an analysis of Juno's first radio occultation experiments. Relying on two-way radio links in the X- and Ka-bands, we processed data from NASA's Deep Space Network antennas through a ray-tracing inversion algorithm. By effectively isolating dispersive effects, we obtained measurements of the neutral atmosphere's characteristics. This enabled the derivation of pressure and temperature profiles from the recorded frequencies. These results complement prior data from Voyager occultations and CIRS observations, providing valuable contributions to our understanding of Jupiter's atmospheric dynamics.},
year = {2025},
preview={jup25.png},
}

@inproceedings{caruso2025characterization,
  title={Characterization of Jupiter's Ionosphere using Juno's Radio Occultation Measurements},
  author={Caruso, Andrea and Gomez Casajus, Luis and Coffin, Drew and Buccino, Dustin and Smirnova, Maria and Galanti, Eli and Gramigna, Edoardo and Parisi, Marzia and Togni, Andrea and Zannoni, Marco and others},
  booktitle={EPSC-DPS Joint Meeting 2025 (EPSC-DPS2025)},
  pages={EPSC--DPS2025},
  year={2025},
  abstract={This work presents a characterization of Jupiter's ionosphere using radio occultation measurements from NASA's Juno spacecraft. By exploiting dual-frequency radio links at X- and Ka-bands, the dispersive contribution to the Doppler shift is isolated, enabling the retrieval of electron density profiles in Jupiter's ionosphere. The analysis provides new insights into the structure and variability of the Jovian ionosphere, complementing neutral atmosphere results from the same occultation experiments and extending the coverage of previous missions.},
}

@inproceedings{togni2025assessing,
  title={Assessing Io's Libration Using JunoCam Acquisitions},
  author={Togni, Andrea and Gomez Casajus, Luis and Zannoni, Marco and Tortora, Paolo},
  booktitle={EGU General Assembly Conference Abstracts},
  pages={EGU25--13503},
  year={2025},
  doi={10.5194/egusphere-egu25-13503},
  abstract={NASA's Juno mission has been orbiting Jupiter since 2016, aiming to unveil the planet's origin and evolutionary history. Equipped with a suite of advanced remote sensing instruments, the spacecraft has delivered groundbreaking insights into Jupiter's atmosphere, magnetic field, and internal structure. During its extended mission, Juno performed close flybys of Io, capturing high-resolution images with JunoCam. This work exploits these images to assess the forced libration of Io, a periodic oscillation in its rotation rate caused by Jupiter's variable gravitational torque along Io's eccentric orbit. Measuring the libration amplitude provides constraints on Io's internal structure, particularly on the presence of a global subsurface magma ocean.},
}

@inproceedings{caruso2025radio,
  title={Radio Occultations with Juno: Unveiling the Structure of Jupiter's Polar Atmosphere and Ionosphere},
  author={Caruso, Andrea and Gomez Casajus, Luis and Smirnova, Maria and Coffin, Drew and Buccino, Dustin and Galanti, Eli and Gramigna, Edoardo and Parisi, Marzia and Togni, Andrea and Zannoni, Marco and others},
  booktitle={EGU General Assembly Conference Abstracts},
  pages={EGU25--16362},
  year={2025},
  doi={10.5194/egusphere-egu25-16362},
  abstract={The Juno extended mission (2023--2025) offers a unique opportunity to study Jupiter's atmosphere by radio occultations. In these experiments, the atmospheric refractivity and the bending angle affecting a radio signal crossing a planetary atmosphere can be inferred by analyzing the Doppler shift induced on the downlink frequencies, at X and Ka bands, recorded at NASA Deep Space Network stations. Starting with perijove 63 in July 2024, Juno's radio occultations have started probing the polar regions above 60°N, including areas near the auroral zones. This work presents pressure-temperature profiles of the neutral atmosphere and electron density profiles of the ionosphere from the analysis of these recent polar occultations, shedding new light on the dynamics and structure of Jupiter's atmosphere.},
}

@inproceedings{togni2024determination,
  title={The Determination of Mercury's Libration with BepiColombo MORE Investigation using Optical Navigation},
  author={Togni, Andrea and Bernacchia, David and Gomez Casajus, Luis and Zannoni, Marco and Tortora, Paolo and Iess, Luciano},
  booktitle={EGU General Assembly Conference Abstracts},
  pages={17741},
  year={2024},
  doi={10.5194/egusphere-egu24-17741},
  abstract={The ESA mission BepiColombo will reach Mercury in late 2025 to begin an extensive exploration of the planet. The Mercury Orbiter Radio-Science Experiment (MORE) is one of the scientific instruments on board the Mercury Planetary Orbiter (MPO), which will enter a polar and eccentric orbit. Among the objectives of MORE is increasing confidence on the state and size of Mercury's core, expected to be at least partially molten and decoupled from the mantle. This work presents simulation results of the MORE radio science experiment for the estimation of the libration amplitude of Mercury during the science phase of BepiColombo, using optical observables extracted from simulated images of Mercury's surface.},
}

@article{caruso2023radio,
  title={Radio occultation data analysis with analytical ray-tracing},
  author={Caruso, A and Bourgoin, A and Togni, A and Zannoni, M and Tortora, P},
  journal={Radio Science},
  volume={58},
  number={9},
  pages={1--22},
  year={2023},
  publisher={AGU},
  doi={10.1029/2023RS007740},
  abstract={Radio occultation experiments are a sensing technique for the remote sounding of planetary atmospheres. The technique exploits the frequency shift of a radio signal due to refraction in a planetary atmosphere to infer physical properties of the neutral atmosphere and ionosphere. This work introduces a new method to process two-way radio occultation data by spherically symmetric atmospheres using an analytical ray-tracing approach. Unlike traditional numerical integration of the geometrical optics equations, the novel algorithm exploits a closed-form solution, providing the bending angle directly without numerical integration. This approach produces results consistent with those obtained by fully numerical algorithms and classical Abel transform methods, while requiring lower computational burden.},
}

@inproceedings{togni2023voyager,
  title={Voyager 2 Radio Occultation of Triton revisited using modernized analysis tools},
  author={Togni, Andrea and Caruso, Andrea and Buccino, Dustin and Zannoni, Marco and Oudrhiri, Kamal and Tortora, Paolo},
  booktitle={EGU General Assembly Conference Abstracts},
  pages={EGU--9714},
  year={2023},
  doi={10.5194/egusphere-egu23-9714},
  abstract={In 1989, the Voyager 2 spacecraft performed a flyby of the Neptune system, and a radio occultation of Triton's ionosphere was carried out on 25 August 1989. Results from this occultation experiment were published by Tyler et al. in Science, with atmospheric profiles estimated from real-time tracking data at time resolutions of about 1 second. This work revisits the Voyager 2 radio occultation data of Triton using modernized analysis tools, including an analytical ray-tracing algorithm, to obtain improved estimates of Triton's atmospheric and ionospheric properties.},
}

@inproceedings{gramigna2022hera,
  title={Hera inter-satellite link doppler characterization for didymos gravity science experiments},
  author={Gramigna, Edoardo and Johansen, Jeppe Gr{\ae}sdal and Manghi, Riccardo Lasagni and Magalh{\~a}es, Jos{\'e} and Zannoni, Marco and Tortora, Paolo and Le Bras, Etienne and Togni, Andrea},
  booktitle={2022 IEEE 9th International Workshop on Metrology for AeroSpace (MetroAeroSpace)},
  pages={430--435},
  year={2022},
  organization={IEEE},
  doi={10.1109/MetroAeroSpace54187.2022.9856049},
  abstract={While ground-based spacecraft radio tracking is a well-established technique, the use of miniaturized space-to-space inter-satellite links capable of determining the Doppler shift due to the relative line-of-sight velocity between two spacecraft has not been explored frequently in the past. The satellite-to-satellite tracking option allows increased accuracy of results for both planetary bodies' mass and gravity field determination as well as spacecraft positioning. In this work, the Hera mission inter-satellite link is described and characterized. Preliminary laboratory test results show that the system meets the end-to-end range-rate requirements for gravity science investigations. Furthermore, numerical simulations of the Hera gravity science experiments demonstrate that the inter-satellite Doppler measurements are crucial for the characterization of the extended gravity field of Didymos.},
}

@inproceedings{togni2021fft,
  title={An FFT-based method for Doppler observables estimation in Deep Space tracking},
  author={Togni, Andrea and Zannoni, Marco and Casaj{\'u}s, Luis G{\'o}mez and Tortora, Paolo},
  booktitle={2021 IEEE 8th International Workshop on Metrology for AeroSpace (MetroAeroSpace)},
  pages={294--299},
  year={2021},
  organization={IEEE},
  doi={10.1109/MetroAeroSpace51421.2021.9511674},
  abstract={Doppler tracking is an essential tool in deep space orbit determination and radio science investigations, and one of the most critical steps in this tracking process is the frequency estimation. The variance of this estimation process directly impacts measurement quality. In this paper, an FFT-based algorithm for frequency estimation is presented and characterized using signals corrupted by additive noise channels of varying intensity. A comparison to the current operational tracking method for Open Loop data, based on Phase-Locked Loops, is presented and discussed. The proposed method offers a viable alternative for Doppler observables estimation in deep space tracking scenarios.},
}

@article{modenini2020dynamic,
  title={A dynamic testbed for nanosatellites attitude verification},
  author={Modenini, Dario and Bahu, Anton and Curzi, Giacomo and Togni, Andrea},
  journal={Aerospace},
  volume={7},
  number={3},
  pages={31},
  year={2020},
  publisher={MDPI},
  doi={10.3390/aerospace7030031},
  abstract={To enable a reliable verification of attitude determination and control systems for nanosatellites, the environment of low Earth orbits with almost disturbance-free rotational dynamics must be simulated. This work describes the design solutions adopted for developing a dynamic nanosatellite attitude simulator testbed at the University of Bologna. The facility integrates several subsystems, including an air-bearing three degree of freedom platform with automatic balancing system, a Helmholtz cage for geomagnetic field simulation, a Sun simulator, and a metrology vision system for ground-truth attitude generation. The main purpose of this work is to offer some cost-effective solutions for their in-house development, and to show through experimental verification that adequate performances can be achieved.},
}
